{
  "expo": {
    "name": "MaVie",
    "slug": "MaVie",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MaVie"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ]
  }
}
