{
  "expo": {
    "name": "MaVie",
    "slug": "MaVie",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to the camera to scan your body."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MaVie",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MaVie to access your camera to scan your body."
        }
      ]
    ]
  }
}